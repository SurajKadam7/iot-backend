# HTTP
HTTP_ADDR=:8080
DATABASE_URL=postgres://iot:iot@127.0.0.1:5432/iot?sslmode=disable
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
WEB_DIST_DIR=web/dist
LOG_LEVEL=info
LOG_FORMAT=text

# Auth: local issues HS256 tokens from /api/dev/login (never enable in production).
# cognito validates RS256 JWTs from Cognito JWKS (send the ID token).
AUTH_MODE=local
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_ISSUER=iot-local
JWT_AUDIENCE=
JWT_JWKS_URL=
JWT_EXPIRY=24h

# For AUTH_MODE=cognito:
# AUTH_MODE=cognito
# JWT_ISSUER=https://cognito-idp.{region}.amazonaws.com/{userPoolId}
# JWT_JWKS_URL=https://cognito-idp.{region}.amazonaws.com/{userPoolId}/.well-known/jwks.json
# JWT_AUDIENCE={appClientId}

# MQTT broker (shared). Subscriber uses MQTT_SUB_*; publisher uses MQTT_PUB_*.
MQTT_ENABLED=true
MQTT_BROKER=tcp://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_INSECURE_SKIP_VERIFY=false
MQTT_KEEP_ALIVE=30s

MQTT_SUB_CLIENT_ID=iot-backend-live
# MQTT_SUB_CA_CERT_PATH=secrets/subscriber/AmazonRootCA1.pem
# MQTT_SUB_CERT_PATH=secrets/subscriber/cert.pem
# MQTT_SUB_KEY_PATH=secrets/subscriber/private.key

MQTT_PUB_CLIENT_ID=iot-dev-publisher
# MQTT_PUB_CA_CERT_PATH=secrets/publisher/AmazonRootCA1.pem
# MQTT_PUB_CERT_PATH=secrets/publisher/cert.pem
# MQTT_PUB_KEY_PATH=secrets/publisher/private.key
# PUB_ORG_ID=00000000-0000-4000-8000-000000000001
# PUB_DEVICES=line-a-01,line-a-02,line-b-01,line-b-02
PUB_INTERVAL=10s

# Archive + export. Empty S3_BUCKET uses the local filesystem (ARCHIVE_DIR).
# Production: set S3_BUCKET and an instance role (never put AWS keys in the browser).
ARCHIVE_ENABLED=true
ARCHIVE_BACKEND=auto
ARCHIVE_DIR=data/archive
S3_BUCKET=
AWS_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000
ARCHIVE_FLUSH_ROWS=100
ARCHIVE_FLUSH_INTERVAL=15s
EXPORT_PREFIX=exports
EXPORT_MAX_RANGE=744h
EXPORT_PRESIGN_TTL=15m
EXPORT_POLL_INTERVAL=2s
